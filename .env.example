# MongoDB connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority"

# Secret key for signing JWT tokens (use a strong, random string)
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_HERE"

# Anthropic API Key for AI features (server-side only, do NOT prefix with VITE_)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Comma-separated list of allowed CORS origins (required in production)
# ALLOWED_ORIGINS="https://your-app.netlify.app,https://your-custom-domain.com"

# (Optional) Frontend Base URL if different from root during development
# VITE_BASE_URL="/"

# (Optional) API URL if Netlify Dev isn't proxying correctly or for external API
# VITE_API_URL="http://localhost:8888/.netlify/functions"

# ─── Supabase (Phase 2 — uncomment when switching backend) ───
# Self-hosted: http://localhost:8000 (or Droplet IP)
# Cloud: https://xyz.supabase.co
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Express API Server (for AI, webhooks, email — Phase 2.5) ───
# VITE_API_URL=http://localhost:3001/api
