{
  "name": "launchcue",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "cd server && npm run dev",
    "dev:supabase": "docker compose -f docker-compose.dev.yml up -d",
    "dev:supabase:down": "docker compose -f docker-compose.dev.yml down",
    "dev:full": "npm run dev:supabase && concurrently \"npm run dev\" \"npm run dev:server\"",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.vue",
    "lint:fix": "eslint src/ --ext .ts,.vue --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@heroicons/vue": "^2.2.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "@vueuse/core": "^13.1.0",
    "autoprefixer": "^10.4.21",
"chart.js": "^4.4.7",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "marked": "^15.0.11",
    "pinia": "^3.0.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.7.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.1",
    "vitest": "^4.0.18",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.2.5"
  }
}
